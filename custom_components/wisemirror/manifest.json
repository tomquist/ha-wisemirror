{
  "domain": "wisemirror",
  "name": "WiseMirror",
  "after_dependencies": [
    "bluetooth"
  ],
  "bluetooth": [
    {
      "local_name": "WiseMirror_BLE*"
    },
    {
      "local_name": "WISE"
    }
  ],
  "codeowners": [
    "@tomquist"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth_adapters"
  ],
  "dhcp": [
    {
      "macaddress": "3030F9*"
    },
    {
      "hostname": "esp_*"
    },
    {
      "hostname": "espressif*"
    },
    {
      "hostname": "wisemirror*"
    }
  ],
  "documentation": "https://github.com/tomquist/ha-wisemirror",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/tomquist/ha-wisemirror/issues",
  "requirements": [],
  "version": "0.2.0"
}
